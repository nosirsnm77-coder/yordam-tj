# Шаблон переменных окружения
# Скопируйте в .env и заполните свои значения:
#   cp .env.example .env
# Файл .env в Git НЕ попадает (см. .gitignore)

# Порт на котором будет работать backend
PORT=3001

# Секретный ключ для подписи JWT-токенов
# В продакшене ОБЯЗАТЕЛЬНО смените на длинную случайную строку!
# Сгенерировать можно так:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=замените_меня_на_длинную_случайную_строку
